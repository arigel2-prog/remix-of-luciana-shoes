# Server-side only. These are read by the Netlify functions, never by the
# browser bundle — do not prefix any of them with VITE_, which would compile
# them into the public JavaScript.

# Turso. From `turso db show <name>` and `turso db tokens create <name>`.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN=""

# Anthropic key for the AI Analytics tab. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Asset prefix. "/trade/" for lucianashoes.com/trade; "/" to build standalone.
APP_BASE_PATH="/trade/"
