# Copy to .env for local development, and set the same two VITE_* values as
# environment variables on the Netlify site (Site configuration -> Environment
# variables). Values set in Netlify override this file at build time.
#
# Both are safe to expose in the browser bundle — the publishable key is the
# anon key, and every table is protected by row-level security.

VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Not read by any source file; kept because Lovable writes it into .env.
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"

# NOT set here and never in the frontend: ANTHROPIC_API_KEY lives only as a
# Supabase Edge Function secret (see DEPLOY.md step 4).
